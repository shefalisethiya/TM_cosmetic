<%- include('../partials/header', { title }) %>
<section class="auth-page">
  <div class="auth-card">
    <span class="auth-eyebrow">WELCOME BACK</span>
    <h1>Sign <em>In</em></h1>
    <p class="auth-intro">Sign in to your TM Cosmetic account.</p>
    <% if (error) { %><div class="auth-alert"><%= error %></div><% } %>
    <form class="auth-form" action="/login" method="POST">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" value="<%= email %>" placeholder="Enter your email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
      <button class="button auth-submit" type="submit">SIGN IN <span>→</span></button>
    </form>
    <p class="auth-switch">New to TM Cosmetic? <a href="/signup">Create an account</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
