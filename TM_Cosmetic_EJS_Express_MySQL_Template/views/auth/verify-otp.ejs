
<%- include('../partials/header', { title }) %>

<section class="auth-page">
  <div class="auth-card">

    <span class="auth-eyebrow">SECURE LOGIN</span>

    <h1>Verify <em>OTP</em></h1>

    <p class="auth-intro">
      Enter the 4-digit OTP generated for your login.
    </p>

    <% if (error) { %>
      <div class="auth-alert">
        <%= error %>
      </div>
    <% } %>

    <% if (message) { %>
      <div class="auth-success">
        <%= message %>
      </div>
    <% } %>

    <!-- OTP VERIFICATION FORM -->
    <form class="auth-form" action="/verify-otp" method="POST">

      <label for="otp">Enter OTP</label>

      <input
        id="otp"
        name="otp"
        type="text"
        inputmode="numeric"
        maxlength="4"
        pattern="[0-9]{4}"
        autocomplete="one-time-code"
        placeholder="Enter 4-digit OTP"
        required
      >

      <button class="button auth-submit" type="submit">
        VERIFY OTP <span>→</span>
      </button>

    </form>

    <!-- RESEND OTP FORM -->
    <form action="/resend-otp" method="POST" class="auth-form">

      <button type="submit" class="button">
        RESEND OTP
      </button>

    </form>

  </div>
</section>

<%- include('../partials/footer') %>
