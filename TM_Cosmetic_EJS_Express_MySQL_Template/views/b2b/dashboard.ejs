
<%
  const formatCurrency = (amount) => {
    return '₹' + Number(amount || 0).toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  };

  const statusClass = (status) => {
    const value = String(status || '').toLowerCase();

    if (value === 'delivered') return 'success';
    if (value === 'placed') return 'primary';
    if (value === 'assigned' || value === 'accepted') return 'info';
    if (value === 'out for delivery') return 'warning';
    if (value === 'rejected' || value === 'returned' || value === 'cancelled') return 'danger';

    return 'secondary';
  };
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || 'B2B Dashboard | TM Cosmetic' %></title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >

  <style>
    body {
      background: #f5f6fa;
      font-family: Arial, sans-serif;
    }

    .sidebar {
      min-height: 100vh;
      background: #25243a;
      color: white;
      padding: 25px 15px;
    }

    .brand {
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 35px;
    }

    .sidebar a {
      display: block;
      color: #d6d5e2;
      text-decoration: none;
      padding: 12px 15px;
      border-radius: 8px;
      margin-bottom: 8px;
      transition: 0.2s ease;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #514d80;
      color: white;
    }

    .main-content {
      padding: 30px;
    }

    .stat-card {
      border: none;
      border-radius: 14px;
      padding: 22px;
      height: 100%;
      box-shadow: 0 3px 15px rgba(0,0,0,0.04);
    }

    /* Clickable dashboard statistics */
    .clickable-stat {
      cursor: pointer;
      transition: all 0.25s ease;
      border: none;
      border-radius: 14px;
    }

    .clickable-stat:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 22px rgba(0,0,0,0.12);
    }

    .clickable-stat:active {
      transform: scale(0.98);
    }

    .stat-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 23px;
      background: #efedff;
      color: #514d80;
    }

    .content-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.04);
    }

    .table th {
      font-size: 13px;
      color: #777;
      white-space: nowrap;
    }

    .table td {
      vertical-align: middle;
    }

    .product-image {
      width: 45px;
      height: 45px;
      object-fit: contain;
      border-radius: 6px;
      background: #f5f5f5;
    }

    .profile-icon {
      width: 55px;
      height: 55px;
      border-radius: 50%;
      background: #efedff;
      color: #514d80;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
    }

    .sidebar .logout-btn {
      display: block;
      width: 100%;
      margin-top: 15px;
    }

    @media (max-width: 767px) {
      .sidebar {
        min-height: auto;
      }

      .main-content {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<div class="container-fluid">
  <div class="row">

    <!-- SIDEBAR -->
    <aside class="col-md-3 col-lg-2 sidebar">

      <div class="brand">
        <i class="bi bi-shop"></i>
        TM Cosmetic
      </div>

      <div class="mb-4 text-white-50 small">
        B2B CUSTOMER PANEL
      </div>

      <a href="/b2b/dashboard" class="active">
        <i class="bi bi-grid me-2"></i>
        Dashboard
      </a>

      <a href="/products">
        <i class="bi bi-box-seam me-2"></i>
        Product Catalogue
      </a>

      <a href="/cart">
        <i class="bi bi-cart3 me-2"></i>
        My Cart
      </a>

      <a href="/checkout">
        <i class="bi bi-credit-card me-2"></i>
        Checkout
      </a>

      <a href="/b2b/orders">
        <i class="bi bi-bag-check me-2"></i>
        My Orders
      </a>

      <hr class="border-secondary">

      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-outline-light logout-btn">
          <i class="bi bi-box-arrow-right me-2"></i>
          Logout
        </button>
      </form>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="col-md-9 col-lg-10 main-content">

      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
          <h3 class="fw-bold mb-1">B2B Dashboard</h3>

          <p class="text-muted mb-0">
            Welcome back, <%= customer.name %>!
          </p>
        </div>

        <a href="/products" class="btn btn-primary">
          <i class="bi bi-bag-plus me-2"></i>
          Browse Products
        </a>

      </div>

      <!-- ==========================================
           CLICKABLE STATISTICS
      ========================================== -->
      <div class="row g-3 mb-4">

        <!-- TOTAL ORDERS -->
        <div class="col-sm-6 col-xl-3">
          <a href="/b2b/orders?filter=total" class="stat-link">
            <div class="card stat-card clickable-stat">
              <div class="d-flex justify-content-between align-items-center">

                <div>
                  <p class="text-muted mb-2">Total Orders</p>
                  <h3 class="fw-bold mb-0">
                    <%= stats.total_orders || 0 %>
                  </h3>
                </div>

                <div class="stat-icon">
                  <i class="bi bi-bag"></i>
                </div>

              </div>
            </div>
          </a>
        </div>

        <!-- ACTIVE ORDERS -->
        <div class="col-sm-6 col-xl-3">
          <a href="/b2b/orders?filter=active" class="stat-link">
            <div class="card stat-card clickable-stat">
              <div class="d-flex justify-content-between align-items-center">

                <div>
                  <p class="text-muted mb-2">Active Orders</p>
                  <h3 class="fw-bold mb-0">
                    <%= stats.active_orders || 0 %>
                  </h3>
                </div>

                <div class="stat-icon">
                  <i class="bi bi-truck"></i>
                </div>

              </div>
            </div>
          </a>
        </div>

        <!-- DELIVERED ORDERS -->
        <div class="col-sm-6 col-xl-3">
          <a href="/b2b/orders?filter=delivered" class="stat-link">
            <div class="card stat-card clickable-stat">
              <div class="d-flex justify-content-between align-items-center">

                <div>
                  <p class="text-muted mb-2">Delivered Orders</p>
                  <h3 class="fw-bold mb-0">
                    <%= stats.delivered_orders || 0 %>
                  </h3>
                </div>

                <div class="stat-icon">
                  <i class="bi bi-check-circle"></i>
                </div>

              </div>
            </div>
          </a>
        </div>

        <!-- PENDING PAYMENTS -->
        <div class="col-sm-6 col-xl-3">
          <a href="/b2b/orders?filter=pending-payment" class="stat-link">
            <div class="card stat-card clickable-stat">
              <div class="d-flex justify-content-between align-items-center">

                <div>
                  <p class="text-muted mb-2">Pending Payments</p>
                  <h3 class="fw-bold mb-0">
                    <%= stats.pending_payments || 0 %>
                  </h3>
                </div>

                <div class="stat-icon">
                  <i class="bi bi-wallet2"></i>
                </div>

              </div>
            </div>
          </a>
        </div>

      </div>

      <!-- PROFILE AND PRODUCT INFORMATION -->
      <div class="row g-3 mb-4">

        <!-- BUSINESS ACCOUNT -->
        <div class="col-lg-8">

          <div class="card content-card p-4 h-100">

            <h5 class="fw-bold mb-3">
              <i class="bi bi-person-circle me-2"></i>
              Business Account
            </h5>

            <div class="d-flex align-items-center gap-3 mb-3">

              <div class="profile-icon">
                <i class="bi bi-person"></i>
              </div>

              <div>
                <h5 class="mb-1"><%= customer.name %></h5>
                <span class="badge bg-primary">B2B Customer</span>
              </div>

            </div>

            <hr>

            <div class="row g-3">

              <div class="col-md-6">
                <small class="text-muted">Email Address</small>
                <div><%= customer.email || 'Not available' %></div>
              </div>

              <div class="col-md-6">
                <small class="text-muted">Mobile Number</small>
                <div><%= customer.phone || 'Not available' %></div>
              </div>

              <div class="col-md-6">
                <small class="text-muted">Account Type</small>
                <div><%= customer.joinas || 'B2B Customer' %></div>
              </div>

              <div class="col-md-6">
                <small class="text-muted">Customer ID</small>
                <div>#<%= customer.id %></div>
              </div>

            </div>

          </div>
        </div>

        <!-- PRODUCT CATALOGUE -->
        <div class="col-lg-4">

          <div class="card content-card p-4 h-100">

            <h5 class="fw-bold mb-3">
              <i class="bi bi-box-seam me-2"></i>
              Product Catalogue
            </h5>

            <h2 class="fw-bold">
              <%= productStats.total_products || 0 %>
            </h2>

            <p class="text-muted">
              Products currently available in inventory.
            </p>

            <a href="/products" class="btn btn-outline-primary mt-auto">
              Explore Products
              <i class="bi bi-arrow-right ms-2"></i>
            </a>

          </div>
        </div>

      </div>

      <!-- RECENT ORDERS -->
      <div class="card content-card p-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

          <h5 class="fw-bold mb-0">Recent Orders</h5>

          <a href="/b2b/orders" class="btn btn-sm btn-outline-primary">
            View All
          </a>

        </div>

        <% if (orders && orders.length > 0) { %>

          <div class="table-responsive">

            <table class="table table-hover align-middle">

              <thead>
                <tr>
                  <th>Order ID</th>
                  <th>Products</th>
                  <th>Total</th>
                  <th>Payment</th>
                  <th>Order Status</th>
                  <th>Date</th>
                </tr>
              </thead>

              <tbody>

                <% orders.forEach(order => { %>

                  <tr>

                    <td>
                      <strong>#<%= order.order_id %></strong>
                    </td>

                    <td>

                      <% if (order.items && order.items.length > 0) { %>

                        <% order.items.forEach(item => { %>

                          <div class="d-flex align-items-center gap-2 mb-2">

                            <% if (item.product_image) { %>

                              <img
                                src="<%= item.product_image %>"
                                class="product-image"
                                alt="Product"
                              >

                            <% } else { %>

                              <div class="product-image d-flex align-items-center justify-content-center">
                                <i class="bi bi-image text-muted"></i>
                              </div>

                            <% } %>

                            <div>

                              <div class="small fw-semibold">
                                <%= item.product_name %>
                              </div>

                              <small class="text-muted">
                                Qty: <%= item.quantity %>
                              </small>

                            </div>

                          </div>

                        <% }); %>

                      <% } else { %>

                        <span class="text-muted">No items</span>

                      <% } %>

                    </td>

                    <td class="fw-semibold">
                      <%= formatCurrency(order.total_amount) %>
                    </td>

                    <td>

                      <div><%= order.payment_method || '-' %></div>

                      <small class="text-muted">
                        <%= order.payment_status || '-' %>
                      </small>

                    </td>

                    <td>

                      <span class="badge bg-<%= statusClass(order.order_status) %>">
                        <%= order.order_status || 'Pending' %>
                      </span>

                      <% if (order.delivery_status_reason) { %>

                        <div class="small text-danger mt-1">
                          <%= order.delivery_status_reason %>
                        </div>

                      <% } %>

                    </td>

                    <td>
                      <small>
                        <%= order.created_at
                          ? new Date(order.created_at).toLocaleDateString('en-IN')
                          : '-' %>
                      </small>
                    </td>

                  </tr>

                <% }); %>

              </tbody>

            </table>

          </div>

        <% } else { %>

          <div class="text-center py-5">

            <i class="bi bi-bag-x display-4 text-muted"></i>

            <h5 class="mt-3">No Orders Yet</h5>

            <p class="text-muted">
              You haven't placed any orders yet.
            </p>

            <a href="/products" class="btn btn-primary">
              Start Shopping
            </a>

          </div>

        <% } %>

      </div>

      <!-- FOOTER -->
      <div class="text-center text-muted mt-4 small">
        © <%= new Date().getFullYear() %> TM Cosmetic. All rights reserved.
      </div>

    </main>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
