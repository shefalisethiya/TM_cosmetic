
<%
  const formatCurrency = (amount) => {
    return '₹' + Number(amount || 0).toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  };

  const statusClass = (status) => {
    const value = String(status || '').toLowerCase();

    if (value === 'delivered') return 'success';
    if (value === 'placed') return 'primary';
    if (value === 'assigned' || value === 'accepted') return 'info';
    if (value === 'out for delivery') return 'warning';
    if (value === 'rejected' || value === 'returned' || value === 'cancelled') return 'danger';

    return 'secondary';
  };
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Total Orders | TM Cosmetic</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    body {
      background: #f5f6fa;
      font-family: Arial, sans-serif;
    }

    .sidebar {
      min-height: 100vh;
      background: #25243a;
      color: white;
      padding: 25px 15px;
    }

    .brand {
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 35px;
    }

    .sidebar a {
      display: block;
      color: #d6d5e2;
      text-decoration: none;
      padding: 12px 15px;
      border-radius: 8px;
      margin-bottom: 8px;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #514d80;
      color: white;
    }

    .main-content {
      padding: 30px;
    }

    .content-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.05);
    }

    .product-image {
      width: 48px;
      height: 48px;
      object-fit: contain;
      background: #f5f5f5;
      border-radius: 6px;
    }

    .filter-link {
      text-decoration: none;
      color: #514d80;
      padding: 9px 14px;
      border-radius: 7px;
      border: 1px solid #514d80;
      display: inline-block;
      margin: 3px;
    }

    .filter-link.active,
    .filter-link:hover {
      background: #514d80;
      color: white;
    }

    @media(max-width: 767px) {
      .sidebar {
        min-height: auto;
      }

      .main-content {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<div class="container-fluid">
  <div class="row">

    <!-- SIDEBAR -->
    <aside class="col-md-3 col-lg-2 sidebar">

      <div class="brand">
        <i class="bi bi-shop"></i>
        TM Cosmetic
      </div>

      <div class="text-white-50 small mb-4">
        B2B CUSTOMER PANEL
      </div>

      <a href="/b2b/dashboard">
        <i class="bi bi-grid me-2"></i>
        Dashboard
      </a>

      <a href="/products">
        <i class="bi bi-box-seam me-2"></i>
        Product Catalogue
      </a>

      <a href="/cart">
        <i class="bi bi-cart3 me-2"></i>
        My Cart
      </a>

      <a href="/checkout">
        <i class="bi bi-credit-card me-2"></i>
        Checkout
      </a>

      <a href="/b2b/orders?filter=total" class="active">
        <i class="bi bi-bag-check me-2"></i>
        My Orders
      </a>

      <hr class="border-secondary">

      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-outline-light w-100">
          <i class="bi bi-box-arrow-right me-2"></i>
          Logout
        </button>
      </form>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="col-md-9 col-lg-10 main-content">

      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
          <h3 class="fw-bold mb-1">Total Orders</h3>
          <p class="text-muted mb-0">
            Welcome, <%= customer.name %>. View all your orders here.
          </p>
        </div>

        <a href="/products" class="btn btn-primary">
          <i class="bi bi-bag-plus me-2"></i>
          Browse Products
        </a>

      </div>

      <!-- ORDER FILTERS -->
      <div class="card content-card p-3 mb-4">

        <div class="d-flex flex-wrap gap-2">

          <a href="/b2b/orders?filter=total"
             class="filter-link active">
            <i class="bi bi-bag me-1"></i>
            Total Orders
          </a>

          <a href="/b2b/orders?filter=active"
             class="filter-link">
            <i class="bi bi-truck me-1"></i>
            Active Orders
          </a>

          <a href="/b2b/orders?filter=delivered"
             class="filter-link">
            <i class="bi bi-check-circle me-1"></i>
            Delivered Orders
          </a>

          <a href="/b2b/orders?filter=pending-payment"
             class="filter-link">
            <i class="bi bi-wallet2 me-1"></i>
            Pending Payments
          </a>

        </div>

      </div>

      <!-- ORDER COUNT -->
      <div class="card content-card p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center">

          <div>
            <h5 class="fw-bold mb-1">All Orders</h5>
            <p class="text-muted mb-0">
              Complete order history
            </p>
          </div>

          <div class="text-end">
            <h2 class="fw-bold text-primary mb-0">
              <%= orders.length %>
            </h2>
            <small class="text-muted">Orders Found</small>
          </div>

        </div>

      </div>

      <!-- ORDERS LIST -->
      <% if (orders && orders.length > 0) { %>

        <% orders.forEach(order => { %>

          <div class="card content-card p-4 mb-4">

            <!-- ORDER HEADER -->
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">

              <div>
                <h5 class="fw-bold mb-1">
                  Order #<%= order.order_id %>
                </h5>

                <small class="text-muted">
                  <i class="bi bi-calendar3 me-1"></i>
                  <%= order.created_at
                    ? new Date(order.created_at).toLocaleDateString('en-IN')
                    : '-' %>
                </small>
              </div>

              <div class="text-end">
                <span class="badge bg-<%= statusClass(order.order_status) %>">
                  <%= order.order_status || 'Pending' %>
                </span>

                <div class="small text-muted mt-2">
                  Payment: <%= order.payment_status || '-' %>
                </div>
              </div>

            </div>

            <hr>

            <!-- PRODUCTS -->
            <h6 class="fw-bold mb-3">
              <i class="bi bi-box-seam me-2"></i>
              Ordered Products
            </h6>

            <% if (order.items && order.items.length > 0) { %>

              <% order.items.forEach(item => { %>

                <div class="d-flex align-items-center gap-3 mb-3">

                  <% if (item.product_image) { %>
                    <img
                      src="<%= item.product_image %>"
                      class="product-image"
                      alt="Product"
                    >
                  <% } else { %>
                    <div class="product-image d-flex align-items-center justify-content-center">
                      <i class="bi bi-image text-muted"></i>
                    </div>
                  <% } %>

                  <div class="flex-grow-1">
                    <div class="fw-semibold">
                      <%= item.product_name %>
                    </div>

                    <small class="text-muted">
                      Quantity: <%= item.quantity %>
                    </small>
                  </div>

                  <div class="fw-semibold">
                    <%= formatCurrency(item.line_total) %>
                  </div>

                </div>

              <% }); %>

            <% } else { %>

              <p class="text-muted">No product details available.</p>

            <% } %>

            <hr>

            <!-- ORDER TOTALS -->
            <div class="row g-3">

              <div class="col-md-6">
                <small class="text-muted">Payment Method</small>
                <div class="fw-semibold">
                  <%= order.payment_method || '-' %>
                </div>
              </div>

              <div class="col-md-6">
                <small class="text-muted">Payment Status</small>
                <div class="fw-semibold">
                  <%= order.payment_status || '-' %>
                </div>
              </div>

              <div class="col-md-6">
                <small class="text-muted">Delivery Address</small>
                <div>
                  <%= [order.address, order.city, order.pincode]
                    .filter(Boolean).join(', ') || 'Not available' %>
                </div>
              </div>

              <div class="col-md-6">
                <small class="text-muted">Delivery Status</small>

                <div>
                  <span class="badge bg-<%= statusClass(order.order_status) %>">
                    <%= order.order_status || 'Pending' %>
                  </span>
                </div>
              </div>

            </div>

            <% if (order.delivery_status_reason) { %>
              <div class="alert alert-warning mt-3 mb-0">
                <strong>Delivery remark:</strong>
                <%= order.delivery_status_reason %>
              </div>
            <% } %>

            <hr>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

              <span class="text-muted">
                Subtotal: <%= formatCurrency(order.subtotal) %>
                <br>
                Delivery: <%= formatCurrency(order.delivery_charge) %>
              </span>

              <h5 class="fw-bold mb-0">
                Total: <%= formatCurrency(order.total_amount) %>
              </h5>

            </div>

          </div>

        <% }); %>

      <% } else { %>

        <div class="card content-card text-center p-5">

          <i class="bi bi-bag-x display-3 text-muted"></i>

          <h5 class="fw-bold mt-3">No Orders Found</h5>

          <p class="text-muted">
            You have not placed any orders yet.
          </p>

          <a href="/products" class="btn btn-primary">
            Start Shopping
          </a>

        </div>

      <% } %>

      <!-- FOOTER -->
      <div class="text-center text-muted mt-4 small">
        © <%= new Date().getFullYear() %> TM Cosmetic. All rights reserved.
      </div>

    </main>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
