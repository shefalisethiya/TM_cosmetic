
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>
    body {
      background: #f5f6fa;
      font-family: Arial, sans-serif;
    }

    .sidebar {
      min-height: 100vh;
      background: #29213b;
      color: white;
      padding: 25px 15px;
    }

    .sidebar h4 {
      color: #fff;
      margin-bottom: 30px;
    }

    .sidebar a {
      display: block;
      color: #ddd;
      text-decoration: none;
      padding: 12px;
      margin-bottom: 8px;
      border-radius: 6px;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #8e44ad;
      color: white;
    }

    .main-content {
      padding: 30px;
    }

    .stat-card {
      border: none;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
      height: 100%;
    }

    .stat-card h6 {
      color: #777;
    }

    .stat-card h3 {
      font-weight: bold;
      margin-top: 10px;
    }

    .section-card {
      background: white;
      border-radius: 12px;
      padding: 22px;
      margin-top: 25px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

    .product-image {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .profile-box {
      background: white;
      padding: 20px;
      border-radius: 12px;
    }

    @media(max-width: 767px) {
      .sidebar {
        min-height: auto;
      }

      .main-content {
        padding: 15px;
      }
    }
  </style>
</head>

<body>

<div class="container-fluid">
  <div class="row">

    <!-- SIDEBAR -->
    <aside class="col-md-2 sidebar">

      <h4>TM Cosmetic</h4>

      <a href="/b2c/dashboard" class="active">
        Dashboard
      </a>

      <a href="/products">
        Shop Products
      </a>

      <a href="/cart">
        My Cart
      </a>

      <a href="#orders">
        My Orders
      </a>

      <a href="#profile">
        My Profile
      </a>

      <form action="/logout" method="POST" class="mt-4">
        <button type="submit" class="btn btn-outline-light w-100">
          Logout
        </button>
      </form>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="col-md-10 main-content">

      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2>Welcome, <%= customer.name %>!</h2>
          <p class="text-muted">
            Welcome to your TM Cosmetic customer dashboard.
          </p>
        </div>

        <a href="/products" class="btn btn-dark">
          Continue Shopping
        </a>
      </div>

      <!-- STATISTICS -->
      <div class="row g-3 mt-2">

        <div class="col-md-4">
          <div class="stat-card bg-white">
            <h6>Total Orders</h6>
            <h3><%= stats.total_orders %></h3>
          </div>
        </div>

        <div class="col-md-4">
          <div class="stat-card bg-white">
            <h6>Delivered Orders</h6>
            <h3><%= stats.delivered_orders %></h3>
          </div>
        </div>

        <div class="col-md-4">
          <div class="stat-card bg-white">
            <h6>Active Orders</h6>
            <h3><%= stats.active_orders %></h3>
          </div>
        </div>

      </div>

      <!-- PROFILE -->
      <section class="section-card" id="profile">
        <h4>My Profile</h4>
        <hr>

        <div class="profile-box">
          <p>
            <strong>Name:</strong>
            <%= customer.name %>
          </p>

          <p>
            <strong>Email:</strong>
            <%= customer.email %>
          </p>

          <p>
            <strong>Phone:</strong>
            <%= customer.phone || 'Not provided' %>
          </p>

          <p>
            <strong>Customer Since:</strong>
            <%= new Date(customer.created_at).toLocaleDateString('en-IN') %>
          </p>
        </div>
      </section>

      <!-- RECENT ORDERS -->
      <section class="section-card" id="orders">

        <div class="d-flex justify-content-between align-items-center">
          <h4>My Recent Orders</h4>
          <span class="text-muted">
            Latest 10 orders
          </span>
        </div>

        <hr>

        <% if (orders && orders.length > 0) { %>

          <% orders.forEach(order => { %>

            <div class="border rounded p-3 mb-3">

              <div class="d-flex justify-content-between flex-wrap gap-2">

                <div>
                  <h6>
                    Order #<%= order.order_id %>
                  </h6>

                  <small class="text-muted">
                    <%= new Date(order.created_at).toLocaleString('en-IN') %>
                  </small>
                </div>

                <div class="text-end">
                  <h5>
                    ₹<%= Number(order.total_amount || 0).toFixed(2) %>
                  </h5>

                  <span class="badge bg-primary">
                    <%= order.order_status %>
                  </span>
                </div>

              </div>

              <div class="mt-3">

                <p class="mb-1">
                  <strong>Payment:</strong>
                  <%= order.payment_method %>
                  (<%= order.payment_status %>)
                </p>

                <p class="mb-2">
                  <strong>Items:</strong>
                </p>

                <% if (order.items && order.items.length > 0) { %>

                  <% order.items.forEach(item => { %>

                    <div class="d-flex align-items-center gap-3 border-top py-2">

                      <% if (item.product_image) { %>
                        <img
                          src="<%= item.product_image %>"
                          alt="<%= item.product_name %>"
                          class="product-image"
                          onerror="this.style.display='none'"
                        >
                      <% } %>

                      <div>
                        <strong><%= item.product_name %></strong>
                        <br>
                        <small class="text-muted">
                          Quantity: <%= item.quantity %>
                        </small>
                      </div>

                      <div class="ms-auto">
                        ₹<%= Number(item.line_total || 0).toFixed(2) %>
                      </div>

                    </div>

                  <% }) %>

                <% } else { %>

                  <p class="text-muted">No item details available.</p>

                <% } %>

              </div>

            </div>

          <% }) %>

        <% } else { %>

          <div class="text-center py-5">
            <h5>No Orders Yet</h5>
            <p class="text-muted">
              You haven't placed any orders yet.
            </p>

            <a href="/products" class="btn btn-dark">
              Start Shopping
            </a>
          </div>

        <% } %>

      </section>

      <!-- QUICK LINKS -->
      <section class="section-card">
        <h4>Quick Actions</h4>
        <hr>

        <div class="d-flex flex-wrap gap-3">

          <a href="/products" class="btn btn-outline-dark">
            Browse Products
          </a>

          <a href="/cart" class="btn btn-outline-dark">
            View Cart
          </a>

          <a href="#orders" class="btn btn-outline-dark">
            Track My Orders
          </a>

        </div>
      </section>

    </main>
  </div>
</div>

</body>
</html>
