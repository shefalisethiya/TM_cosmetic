
<%
  const formatCurrency = (amount) =>
    '₹' + Number(amount || 0).toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

  const statusClass = (status) => {
    const value = String(status || '').toLowerCase();

    if (value === 'delivered') return 'success';
    if (value === 'rejected' || value === 'returned') return 'danger';
    if (value === 'out for delivery') return 'info';
    if (value === 'accepted') return 'primary';
    if (value === 'assigned') return 'warning';
    return 'secondary';
  };

  const getNextStatuses = (status) => {
    const value = String(status || '').toLowerCase();

    if (value === 'assigned') return ['Accepted', 'Rejected'];
    if (value === 'accepted') return ['Out for Delivery', 'Rejected'];
    if (value === 'out for delivery') {
      return ['Delivered', 'Rejected', 'Returned'];
    }

    return [];
  };
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title || 'Delivery Dashboard | TM Cosmetic' %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background: #f7f7fb;
      font-family: Arial, sans-serif;
      color: #292536;
    }

    .sidebar {
      min-height: 100vh;
      background: #251b35;
      color: white;
      padding: 25px 15px;
    }

    .brand {
      font-size: 23px;
      font-weight: bold;
      color: #fff;
      margin-bottom: 35px;
      text-align: center;
    }

    .sidebar a {
      display: block;
      color: #ddd5e8;
      text-decoration: none;
      padding: 12px 15px;
      margin-bottom: 8px;
      border-radius: 8px;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #594174;
      color: white;
    }

    .main-content {
      padding: 30px;
    }

    .stat-card,
    .section-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 3px 15px rgba(0,0,0,.04);
    }

    .stat-card {
      height: 100%;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 7px 20px rgba(0,0,0,.10);
    }

    .stat-link {
      display: block;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }

    .stat-link:hover {
      color: inherit;
    }

    .stat-link:focus-visible {
      outline: 3px solid #68468a;
      outline-offset: 3px;
      border-radius: 14px;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0e9f8;
      color: #68468a;
      font-size: 22px;
    }

    .order-card {
      border: 1px solid #e9e5ef;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 18px;
      background: #fff;
    }

    .product-image {
      width: 45px;
      height: 45px;
      object-fit: contain;
      background: #f7f7f7;
      border-radius: 7px;
      margin-right: 10px;
    }

    .order-item {
      font-size: 13px;
      color: #777;
    }

    .badge {
      padding: 7px 10px;
      font-weight: 500;
    }

    .customer-details {
      background: #faf9fc;
      border-radius: 10px;
      padding: 15px;
    }

    .update-form {
      background: #faf9fc;
      border-radius: 10px;
      padding: 15px;
    }

    .filter-info {
      display: none;
    }

    @media (max-width: 767px) {
      .sidebar {
        min-height: auto;
      }

      .main-content {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<div class="container-fluid">
  <div class="row">

    <!-- SIDEBAR -->
    <aside class="col-md-3 col-lg-2 sidebar">

      <div class="brand">TM COSMETIC</div>

      <div class="text-center mb-4">
        <i class="bi bi-person-circle fs-1"></i>

        <h6 class="mt-2 mb-0">
          <%= deliveryPerson ? deliveryPerson.name : 'Delivery Person' %>
        </h6>

        <small class="text-white-50">Delivery Person</small>
      </div>

      <a href="/delivery/dashboard" class="active">
        <i class="bi bi-speedometer2 me-2"></i>
        Dashboard
      </a>

      <a href="#assigned-orders" onclick="filterOrders('all')">
        <i class="bi bi-box-seam me-2"></i>
        Assigned Orders
      </a>

      <a href="/logout">
        <i class="bi bi-box-arrow-right me-2"></i>
        Logout
      </a>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="col-md-9 col-lg-10 main-content">

      <!-- HEADER -->
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
          <h3 class="fw-bold mb-1">
            Welcome, <%= deliveryPerson ? deliveryPerson.name : 'Delivery Person' %>!
          </h3>

          <p class="text-secondary mb-0">
            Manage your assigned deliveries here.
          </p>
        </div>

        <a href="/delivery/dashboard" class="btn btn-dark">
          <i class="bi bi-arrow-clockwise me-2"></i>
          Refresh
        </a>

      </div>

      <!-- STATISTICS -->
      <div class="row g-3 mb-4">

        <!-- TOTAL ORDERS -->
        <div class="col-6 col-xl-3">
          <a href="#assigned-orders"
             class="stat-link"
             onclick="filterOrders('all')">

            <div class="card stat-card p-3">
              <div class="stat-icon mb-3">
                <i class="bi bi-box-seam"></i>
              </div>

              <h3 class="fw-bold">
                <%= stats.total_orders || 0 %>
              </h3>

              <p class="text-secondary mb-0">
                Total Assigned Orders
              </p>
            </div>

          </a>
        </div>

        <!-- ASSIGNED ORDERS -->
        <div class="col-6 col-xl-3">
          <a href="#assigned-orders"
             class="stat-link"
             onclick="filterOrders('assigned')">

            <div class="card stat-card p-3">
              <div class="stat-icon mb-3">
                <i class="bi bi-clock-history"></i>
              </div>

              <h3 class="fw-bold">
                <%= stats.assigned_orders || 0 %>
              </h3>

              <p class="text-secondary mb-0">
                New Assignments
              </p>
            </div>

          </a>
        </div>

        <!-- IN PROGRESS -->
        <div class="col-6 col-xl-3">
          <a href="#assigned-orders"
             class="stat-link"
             onclick="filterOrders('progress')">

            <div class="card stat-card p-3">
              <div class="stat-icon mb-3">
                <i class="bi bi-truck"></i>
              </div>

              <h3 class="fw-bold">
                <%= (stats.accepted_orders || 0) + (stats.out_for_delivery_orders || 0) %>
              </h3>

              <p class="text-secondary mb-0">
                In Progress
              </p>
            </div>

          </a>
        </div>

        <!-- DELIVERED ORDERS -->
        <div class="col-6 col-xl-3">
          <a href="#assigned-orders"
             class="stat-link"
             onclick="filterOrders('delivered')">

            <div class="card stat-card p-3">
              <div class="stat-icon mb-3">
                <i class="bi bi-check-circle"></i>
              </div>

              <h3 class="fw-bold">
                <%= stats.delivered_orders || 0 %>
              </h3>

              <p class="text-secondary mb-0">
                Delivered Orders
              </p>
            </div>

          </a>
        </div>

      </div>

      <!-- DELIVERY PROFILE -->
      <div class="card section-card p-4 mb-4">

        <h5 class="fw-bold mb-3">
          <i class="bi bi-person-circle me-2"></i>
          My Profile
        </h5>

        <div class="row">

          <div class="col-md-4 mb-3">
            <small class="text-secondary">Full Name</small>
            <div class="fw-semibold">
              <%= deliveryPerson ? deliveryPerson.name : 'N/A' %>
            </div>
          </div>

          <div class="col-md-4 mb-3">
            <small class="text-secondary">Email Address</small>
            <div class="fw-semibold">
              <%= deliveryPerson ? (deliveryPerson.email || 'Not provided') : 'N/A' %>
            </div>
          </div>

          <div class="col-md-4 mb-3">
            <small class="text-secondary">Mobile Number</small>
            <div class="fw-semibold">
              <%= deliveryPerson ? (deliveryPerson.phone || 'Not provided') : 'N/A' %>
            </div>
          </div>

        </div>
      </div>

      <!-- ASSIGNED ORDERS -->
      <div class="card section-card p-4" id="assigned-orders">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

          <h5 class="fw-bold mb-0">
            <i class="bi bi-box-seam me-2"></i>
            My Assigned Orders
          </h5>

          <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-dark" id="visible-order-count">
              <%= orders ? orders.length : 0 %> Orders
            </span>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    onclick="filterOrders('all')">
              Show All
            </button>
          </div>

        </div>

        <div class="filter-info alert alert-light border py-2" id="filter-info">
          Showing: <strong id="filter-label">All Orders</strong>
        </div>

        <% if (orders && orders.length > 0) { %>

          <% orders.forEach(order => { %>

            <%
              const currentStatus = String(order.order_status || '').toLowerCase();
              const nextStatuses = getNextStatuses(order.order_status);
              const orderId = order.id || order.order_id;
            %>

            <div class="order-card"
                 data-status="<%= order.order_status || 'Assigned' %>">

              <!-- ORDER HEADER -->
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                <div>
                  <h6 class="fw-bold mb-1">
                    Order #<%= orderId %>
                  </h6>

                  <small class="text-secondary">
                    <i class="bi bi-calendar3 me-1"></i>

                    <%= order.created_at
                      ? new Date(order.created_at).toLocaleString('en-IN')
                      : 'Date not available' %>
                  </small>
                </div>

                <span class="badge text-bg-<%= statusClass(order.order_status) %>">
                  <%= order.order_status || 'Assigned' %>
                </span>

              </div>

              <!-- CUSTOMER DETAILS -->
              <div class="customer-details mb-3">

                <h6 class="fw-bold mb-3">
                  <i class="bi bi-person me-2"></i>
                  Customer Details
                </h6>

                <div class="row">

                  <div class="col-md-6 mb-2">
                    <small class="text-secondary">Customer Name</small>
                    <div class="fw-semibold">
                      <%= order.customer_name || 'N/A' %>
                    </div>
                  </div>

                  <div class="col-md-6 mb-2">
                    <small class="text-secondary">Mobile Number</small>
                    <div class="fw-semibold">
                      <%= order.mobile || 'N/A' %>
                    </div>
                  </div>

                  <div class="col-12 mt-2">
                    <small class="text-secondary">Delivery Address</small>
                    <div class="fw-semibold">
                      <%= order.address || 'N/A' %>,
                      <%= order.city || '' %>
                      <%= order.pincode || '' %>
                    </div>
                  </div>

                </div>
              </div>

              <!-- ORDER ITEMS -->
              <h6 class="fw-bold mb-3">
                <i class="bi bi-bag me-2"></i>
                Order Items
              </h6>

              <% if (order.items && order.items.length > 0) { %>

                <% order.items.forEach(item => { %>

                  <div class="d-flex align-items-center mb-3">

                    <% if (item.product_image) { %>
                      <img
                        src="<%= item.product_image %>"
                        class="product-image"
                        alt="<%= item.product_name || 'Product' %>"
                        onerror="this.style.display='none'"
                      >
                    <% } %>

                    <div class="flex-grow-1">
                      <div class="fw-semibold">
                        <%= item.product_name || 'Product' %>
                      </div>

                      <div class="order-item">
                        Quantity: <%= item.quantity || 0 %>
                        × <%= formatCurrency(item.price) %>
                      </div>
                    </div>

                    <strong>
                      <%= formatCurrency(item.line_total) %>
                    </strong>

                  </div>

                <% }) %>

              <% } else { %>

                <p class="text-secondary small">
                  Product details unavailable.
                </p>

              <% } %>

              <hr>

              <!-- PAYMENT AND TOTAL -->
              <div class="row align-items-center mb-3">

                <div class="col-md-6 mb-2">
                  <small class="text-secondary">Payment Method</small>

                  <div class="fw-semibold">
                    <%= order.payment_method || 'N/A' %>
                  </div>

                  <small class="text-secondary">
                    Payment Status:
                    <%= order.payment_status || 'N/A' %>
                  </small>
                </div>

                <div class="col-md-6 text-md-end">
                  <small class="text-secondary">Order Total</small>

                  <div class="fw-bold fs-5">
                    <%= formatCurrency(order.total_amount) %>
                  </div>
                </div>

              </div>

              <!-- PREVIOUS DELIVERY REASON -->
              <% if (order.delivery_status_reason) { %>

                <div class="alert alert-warning py-2">
                  <strong>Previous Status Reason:</strong>
                  <%= order.delivery_status_reason %>
                </div>

              <% } %>

              <!-- UPDATE DELIVERY STATUS -->
              <% if (nextStatuses.length > 0) { %>

                <div class="update-form">

                  <h6 class="fw-bold mb-3">
                    <i class="bi bi-arrow-repeat me-2"></i>
                    Update Delivery Status
                  </h6>

                  <form
                    action="/delivery/orders/<%= orderId %>/status"
                    method="POST"
                    class="status-update-form"
                  >

                    <div class="row align-items-end">

                      <div class="col-md-5 mb-3">
                        <label class="form-label fw-semibold">
                          New Status
                        </label>

                        <select
                          name="status"
                          class="form-select status-select"
                          required
                        >
                          <option value="">Select Status</option>

                          <% nextStatuses.forEach(status => { %>
                            <option value="<%= status %>">
                              <%= status %>
                            </option>
                          <% }) %>

                        </select>
                      </div>

                      <div class="col-md-5 mb-3 reason-wrapper d-none">

                        <label class="form-label fw-semibold">
                          Reason for Rejection / Return
                        </label>

                        <textarea
                          name="reason"
                          class="form-control reason-input"
                          rows="2"
                          maxlength="255"
                          placeholder="Enter reason"
                        ></textarea>

                      </div>

                      <div class="col-md-2 mb-3">
                        <button type="submit" class="btn btn-dark w-100">
                          <i class="bi bi-check2-circle me-1"></i>
                          Update
                        </button>
                      </div>

                    </div>

                  </form>

                </div>

              <% } else { %>

                <div class="alert alert-light border mb-0">

                  <i class="bi bi-info-circle me-2"></i>

                  <% if (currentStatus === 'delivered') { %>
                    This order has been successfully delivered.
                  <% } else if (currentStatus === 'rejected' || currentStatus === 'returned') { %>
                    This order is marked as <%= order.order_status %>.
                  <% } else { %>
                    No further status updates are available.
                  <% } %>

                </div>

              <% } %>

            </div>

          <% }) %>

          <div class="text-center py-3 d-none" id="no-filter-results">
            <i class="bi bi-search fs-2 text-secondary"></i>
            <h6 class="mt-2">No matching orders</h6>
            <p class="text-secondary mb-0">
              There are no orders in this category.
            </p>
          </div>

        <% } else { %>

          <div class="text-center py-5">

            <i class="bi bi-truck fs-1 text-secondary"></i>

            <h6 class="mt-3">No Assigned Orders</h6>

            <p class="text-secondary">
              You don't have any delivery orders assigned yet.
            </p>

            <a href="/delivery/dashboard" class="btn btn-dark">
              Refresh Dashboard
            </a>

          </div>

        <% } %>

      </div>

      <p class="text-center text-secondary small mt-4">
        © <%= new Date().getFullYear() %> TM Cosmetic. All Rights Reserved.
      </p>

    </main>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  // ==========================================
  // DASHBOARD CARD FILTERS
  // ==========================================

  function filterOrders(filter) {

    const cards = document.querySelectorAll('.order-card');
    const filterInfo = document.getElementById('filter-info');
    const filterLabel = document.getElementById('filter-label');
    const countElement = document.getElementById('visible-order-count');
    const noResults = document.getElementById('no-filter-results');

    const labels = {
      all: 'All Orders',
      assigned: 'New Assignments',
      progress: 'In Progress',
      delivered: 'Delivered Orders'
    };

    let visibleCount = 0;

    cards.forEach(card => {

      const status = (card.dataset.status || '').toLowerCase();

      let show = false;

      if (filter === 'all') {
        show = true;
      } else if (filter === 'assigned') {
        show = status === 'assigned';
      } else if (filter === 'progress') {
        show = status === 'accepted' ||
               status === 'out for delivery';
      } else if (filter === 'delivered') {
        show = status === 'delivered';
      }

      card.style.display = show ? '' : 'none';

      if (show) {
        visibleCount++;
      }

    });

    if (filterInfo) {
      filterInfo.style.display = 'block';
    }

    if (filterLabel) {
      filterLabel.textContent = labels[filter] || 'All Orders';
    }

    if (countElement) {
      countElement.textContent = visibleCount + ' Orders';
    }

    if (noResults) {
      noResults.classList.toggle('d-none', visibleCount !== 0);
    }
  }

  // ==========================================
  // DELIVERY STATUS UPDATE FORM
  // ==========================================

  document.querySelectorAll('.status-update-form').forEach(form => {

    const statusSelect = form.querySelector('.status-select');
    const reasonWrapper = form.querySelector('.reason-wrapper');
    const reasonInput = form.querySelector('.reason-input');

    const updateReasonField = () => {

      const selectedStatus = statusSelect.value.toLowerCase();

      const requiresReason =
        selectedStatus === 'rejected' ||
        selectedStatus === 'returned';

      reasonWrapper.classList.toggle('d-none', !requiresReason);

      reasonInput.required = requiresReason;
    };

    statusSelect.addEventListener('change', updateReasonField);

    form.addEventListener('submit', event => {

      updateReasonField();

      if (reasonInput.required && !reasonInput.value.trim()) {

        event.preventDefault();

        reasonInput.focus();

        alert('Please enter a reason for rejection or return.');
      }

    });

  });
</script>

</body>
</html>
