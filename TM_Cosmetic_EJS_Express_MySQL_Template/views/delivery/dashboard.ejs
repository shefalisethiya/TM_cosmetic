
<%
  const formatCurrency = (amount) =>
    '₹' + Number(amount || 0).toLocaleString('en-IN', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

  const statusClass = (status) => {
    const value = String(status || '').toLowerCase();

    if (value === 'delivered') return 'success';
    if (value === 'rejected' || value === 'returned' || value === 'cancelled') return 'danger';
    if (value === 'pending payment') return 'warning';
    return 'primary';
  };
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'My Dashboard | TM Cosmetic' %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background: #f7f7fb;
      font-family: Arial, sans-serif;
      color: #292536;
    }

    .sidebar {
      min-height: 100vh;
      background: #251b35;
      color: white;
      padding: 25px 15px;
    }

    .brand {
      font-size: 23px;
      font-weight: bold;
      color: #fff;
      margin-bottom: 35px;
      text-align: center;
    }

    .sidebar a {
      display: block;
      color: #ddd5e8;
      text-decoration: none;
      padding: 12px 15px;
      margin-bottom: 8px;
      border-radius: 8px;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background: #594174;
      color: white;
    }

    .main-content {
      padding: 30px;
    }

    .stat-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 3px 15px rgba(0,0,0,.04);
      height: 100%;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0e9f8;
      color: #68468a;
      font-size: 22px;
    }

    .section-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 3px 15px rgba(0,0,0,.04);
    }

    .order-item {
      font-size: 13px;
      color: #777;
    }

    .product-image {
      width: 45px;
      height: 45px;
      object-fit: contain;
      background: #f7f7f7;
      border-radius: 7px;
      margin-right: 8px;
    }

    .badge {
      padding: 7px 10px;
      font-weight: 500;
    }

    @media (max-width: 767px) {
      .sidebar {
        min-height: auto;
      }

      .main-content {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<div class="container-fluid">
  <div class="row">

    <!-- SIDEBAR -->
    <aside class="col-md-3 col-lg-2 sidebar">
      <div class="brand">TM COSMETIC</div>

      <div class="text-center mb-4">
        <i class="bi bi-person-circle fs-1"></i>
        <h6 class="mt-2 mb-0"><%= customer.name %></h6>
        <small class="text-white-50">B2C Customer</small>
      </div>

      <a href="/b2c/dashboard" class="active">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard
      </a>

      <a href="/products">
        <i class="bi bi-shop me-2"></i> Continue Shopping
      </a>

      <a href="/cart">
        <i class="bi bi-cart3 me-2"></i> My Cart
      </a>

      <a href="/b2c/orders">
        <i class="bi bi-box-seam me-2"></i> My Orders
      </a>

      <a href="/b2c/profile">
        <i class="bi bi-person me-2"></i> My Profile
      </a>

      <a href="/logout">
        <i class="bi bi-box-arrow-right me-2"></i> Logout
      </a>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="col-md-9 col-lg-10 main-content">

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
          <h3 class="fw-bold mb-1">Welcome, <%= customer.name %>!</h3>
          <p class="text-secondary mb-0">Your personal shopping dashboard</p>
        </div>

        <a href="/products" class="btn btn-dark">
          <i class="bi bi-bag me-2"></i> Shop Now
        </a>
      </div>

      <!-- STATISTICS -->
      <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
          <div class="card stat-card p-3">
            <div class="stat-icon mb-3">
              <i class="bi bi-bag-check"></i>
            </div>
            <h3 class="fw-bold"><%= stats.total_orders || 0 %></h3>
            <p class="text-secondary mb-0">Total Orders</p>
          </div>
        </div>

        <div class="col-6 col-xl-3">
          <div class="card stat-card p-3">
            <div class="stat-icon mb-3">
              <i class="bi bi-truck"></i>
            </div>
            <h3 class="fw-bold"><%= stats.active_orders || 0 %></h3>
            <p class="text-secondary mb-0">Active Orders</p>
          </div>
        </div>

        <div class="col-6 col-xl-3">
          <div class="card stat-card p-3">
            <div class="stat-icon mb-3">
              <i class="bi bi-check-circle"></i>
            </div>
            <h3 class="fw-bold"><%= stats.delivered_orders || 0 %></h3>
            <p class="text-secondary mb-0">Delivered Orders</p>
          </div>
        </div>

        <div class="col-6 col-xl-3">
          <div class="card stat-card p-3">
            <div class="stat-icon mb-3">
              <i class="bi bi-person"></i>
            </div>
            <h6 class="fw-bold mt-2">My Account</h6>
            <p class="text-secondary mb-0">Customer Profile</p>
          </div>
        </div>

      </div>

      <!-- CUSTOMER PROFILE -->
      <div class="card section-card p-4 mb-4">
        <h5 class="fw-bold mb-3">My Profile</h5>

        <div class="row">
          <div class="col-md-4 mb-3">
            <small class="text-secondary">Full Name</small>
            <div class="fw-semibold"><%= customer.name %></div>
          </div>

          <div class="col-md-4 mb-3">
            <small class="text-secondary">Email Address</small>
            <div class="fw-semibold"><%= customer.email %></div>
          </div>

          <div class="col-md-4 mb-3">
            <small class="text-secondary">Mobile Number</small>
            <div class="fw-semibold"><%= customer.phone || 'Not provided' %></div>
          </div>
        </div>
      </div>

      <!-- RECENT ORDERS -->
      <div class="card section-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Recent Orders</h5>
          <a href="/b2c/orders" class="text-decoration-none">View All</a>
        </div>

        <% if (orders && orders.length > 0) { %>

          <% orders.forEach(order => { %>

            <div class="border rounded-3 p-3 mb-3">

              <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
                <div>
                  <strong>Order #<%= order.order_id %></strong>
                  <div class="text-secondary small">
                    <%= new Date(order.created_at).toLocaleDateString('en-IN') %>
                  </div>
                </div>

                <span class="badge text-bg-<%= statusClass(order.order_status) %>">
                  <%= order.order_status %>
                </span>
              </div>

              <% if (order.items && order.items.length > 0) { %>

                <% order.items.forEach(item => { %>
                  <div class="d-flex align-items-center mb-2">

                    <% if (item.product_image) { %>
                      <img
                        src="<%= item.product_image %>"
                        class="product-image"
                        alt="<%= item.product_name %>"
                        onerror="this.style.display='none'"
                      >
                    <% } %>

                    <div class="flex-grow-1">
                      <div class="fw-semibold"><%= item.product_name %></div>
                      <div class="order-item">
                        Quantity: <%= item.quantity %>
                        × <%= formatCurrency(item.price) %>
                      </div>
                    </div>

                    <strong><%= formatCurrency(item.line_total) %></strong>

                  </div>
                <% }) %>

              <% } else { %>
                <p class="text-secondary small">Product details unavailable.</p>
              <% } %>

              <hr>

              <div class="d-flex justify-content-between flex-wrap gap-2">
                <div>
                  <small class="text-secondary">Payment</small>
                  <div class="fw-semibold">
                    <%= order.payment_method || 'N/A' %>
                    (<%= order.payment_status || 'N/A' %>)
                  </div>
                </div>

                <div class="text-end">
                  <small class="text-secondary">Order Total</small>
                  <div class="fw-bold fs-5">
                    <%= formatCurrency(order.total_amount) %>
                  </div>
                </div>
              </div>

            </div>

          <% }) %>

        <% } else { %>

          <div class="text-center py-5">
            <i class="bi bi-bag-x fs-1 text-secondary"></i>
            <h6 class="mt-3">No Orders Yet</h6>
            <p class="text-secondary">Start shopping and your orders will appear here.</p>
            <a href="/products" class="btn btn-dark">Explore Products</a>
          </div>

        <% } %>

      </div>

      <p class="text-center text-secondary small mt-4">
        © <%= new Date().getFullYear() %> TM Cosmetic. All Rights Reserved.
      </p>

    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
