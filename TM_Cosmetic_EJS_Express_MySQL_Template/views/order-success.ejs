
<%- include('partials/header', { title }) %>

<section class="page-banner">
  <div class="eyebrow">TM COSMETIC · ORDER CONFIRMATION</div>
  <h1>Thank you for <em>your order!</em></h1>
  <p>Your beauty essentials are getting ready for their journey to you.</p>
</section>

<section class="section success-page">

  <div class="success-icon">✓</div>

  <h2>Order successfully <em>placed.</em></h2>

  <p class="success-message">
    Thank you for shopping with TM Cosmetic.
    We have received your order.
  </p>

  <div class="order-details">

    <div class="order-number">
      <span>ORDER NUMBER</span>
      <strong>#TM<%= order.id %></strong>
    </div>

    <div class="order-status">
      <span>ORDER STATUS</span>
      <strong><%= order.order_status %></strong>
    </div>

    <div class="order-status">
      <span>PAYMENT METHOD</span>
       <strong><%= order.payment_method %></strong>
    </div>

  </div>

  <div class="success-order-summary">

    <h3>Your order summary</h3>

    <% items.forEach(item => { %>

      <div class="success-product">

        <div class="success-product-image">
          <% if (item.product_image) { %>
            <img
              src="<%= item.product_image %>"
              alt="<%= item.product_name %>"
            >
          <% } %>
        </div>

        <div class="success-product-info">
          <strong><%= item.product_name %></strong>
          <small>Quantity: <%= item.quantity %></small>
        </div>

        <strong>
          ₹<%= Number(item.line_total).toLocaleString('en-IN') %>
        </strong>

      </div>

    <% }) %>

    <div class="success-total">
      <span>Total Amount</span>
      <strong>
        ₹<%= Number(order.total_amount).toLocaleString('en-IN') %>
      </strong>
    </div>

    <p class="cod-note">
      Payment of ₹<%= Number(order.total_amount).toLocaleString('en-IN') %>
      is due when your order is delivered.
    </p>

  </div>

  <div class="success-actions">
    <a href="/products" class="button">
      Continue Shopping →
    </a>
  </div>

</section>

<style>
.success-page {
  max-width: 750px;
  margin: 0 auto;
  text-align: center;
}

.success-icon {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: #edf6ed;
  color: #51875a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 35px;
  margin: 0 auto 25px;
}

.success-page h2 {
  margin-bottom: 12px;
}

.success-message {
  color: #777;
  font-size: 14px;
  line-height: 1.7;
}

.order-details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  padding: 25px 10px;
  margin: 30px 0;
  background: #faf7f4;
}

.order-number,
.order-status {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.order-details span {
  font-size: 10px;
  letter-spacing: 1px;
  color: #888;
}

.order-details strong {
  font-size: 14px;
}

.success-order-summary {
  text-align: left;
  border: 1px solid #eee5df;
  padding: 25px;
}

.success-order-summary h3 {
  margin: 0 0 22px;
}

.success-product {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 13px 0;
  border-bottom: 1px solid #eee5df;
}

.success-product-image {
  width: 60px;
  height: 65px;
  background: #f5f0ec;
  flex-shrink: 0;
}

.success-product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.success-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.success-product-info strong {
  font-size: 13px;
}

.success-product-info small {
  color: #888;
  font-size: 12px;
}

.success-product > strong {
  font-size: 13px;
}

.success-total {
  display: flex;
  justify-content: space-between;
  padding-top: 22px;
  font-size: 17px;
  font-weight: 700;
}

.cod-note {
  font-size: 12px;
  color: #777;
  margin-top: 15px;
}

.success-actions {
  margin-top: 30px;
}

@media (max-width: 550px) {
  .order-details {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .success-order-summary {
    padding: 15px;
  }
}
</style>

<%- include('partials/footer') %>
