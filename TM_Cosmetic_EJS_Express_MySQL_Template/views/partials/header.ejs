  <meta name="description" content="Discover beauty and skincare essentials at TM Cosmetic.">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="announcement">A LITTLE SELF-CARE, A LOT OF LOVE <span>✦</span> DELIVERED RIGHT TO YOUR DOORSTEP</div>
<header class="header">
