      </button>

      <div class="mega">
        <div class="mega-col">
          <h4>Moisturisers</h4>
          <ul>
            <li><a href="/products?category=Skin%20Care&sub=Face%20Moisturizer">Face Moisturizer</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Day%20%26%20Night%20Cream">Day &amp; Night Cream</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Body%20Butter">Body Butter</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Beauty%20Oil">Beauty Oil</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Serums">Serums</a></li>
          </ul>
        </div>

        <div class="mega-col">
          <h4>Facial Care</h4>
          <ul>
            <li><a href="/products?category=Skin%20Care&sub=Face%20Wash">Face Wash</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Face%20Scrub">Face Scrub</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Facial%20Serum">Facial Serum</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Face%20Mask">Face Mask</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Face%20Toner">Face Toner</a></li>
          </ul>
        </div>

        <div class="mega-col">
          <h4>Eye &amp; Lip Care</h4>
          <ul>
            <li><a href="/products?category=Skin%20Care&sub=Under%20Eye%20Cream">Under Eye Cream &amp; Serum</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Eye%20Mask">Eye Mask</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Lip%20Balm">Lip Balm</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Lip%20Scrub">Lip Scrub</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Lip%20Masks">Lip Masks</a></li>
          </ul>
        </div>

        <div class="mega-col">
          <h4>Body Care</h4>
          <ul>
            <li><a href="/products?category=Skin%20Care&sub=Body%20Wash">Body Wash</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Body%20Lotion">Body Lotion</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Shower%20Gel">Shower Gel</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Body%20Massage%20Oil">Body Massage Oil</a></li>
            <li><a href="/products?category=Skin%20Care&sub=Body%20Soap">Body Soap</a></li>
          </ul>
        </div>

        <div class="mega-col">
          <h4>Makeup</h4>
          <ul>
            <li><a href="/products?category=Makeup&sub=Face%20Primer">Face Primer</a></li>
            <li><a href="/products?category=Makeup&sub=Concealer">Concealer</a></li>
            <li><a href="/products?category=Makeup&sub=Blush">Blush</a></li>
