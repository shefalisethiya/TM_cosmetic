    <li><a href="/products?category=Skin%20Care">Skin care</a></li>
    <li><a href="/products?category=Makeup">Makeup</a></li>
    <li><a href="/#about">Our story</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
</nav>
  <div class="header-actions">
    <div class="account-menu">
      <button class="icon-button account-trigger" type="button" aria-label="Account menu" aria-expanded="false" id="accountToggle"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-4 3-6 7-6s6.5 2 7 6"/></svg></button>
      <div class="account-dropdown" id="accountDropdown">
        <% if (currentUser) { %>
          <p class="account-welcome">Hello, <strong><%= currentUser.name %></strong></p>
          <a class="account-primary" href="/products">Continue Shopping</a>
          <form action="/logout" method="POST"><button class="account-link-button" type="submit">Sign Out</button></form>
        <% } else { %>
          <a class="account-primary" href="/login">Sign In</a>
          <a class="account-secondary" href="/signup">Sign Up</a>
        <% } %>
      </div>
    </div>
   <a class="icon-button bag-icon" href="/cart" aria-label="Shopping bag">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
  <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
    <span class="cart-count"><%= cartCount %></span>
  <% } %>
</a>
  </div>
</header>


<script>
(function () {
  const shop = document.getElementById('shopMenu');
  const nav = document.getElementById('nav');
  const menuToggle = document.getElementById('menuToggle');
  if (!shop || !nav) return;

  const trigger = shop.querySelector('.mega-trigger');
  const isDesktop = () => window.matchMedia('(min-width:981px)').matches;
  const setOpen = (open) => {
    shop.classList.toggle('open', open);
    trigger.setAttribute('aria-expanded', open);
  };

  trigger.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!shop.classList.contains('open'));
  });
  shop.addEventListener('mouseenter', () => isDesktop() && setOpen(true));
  shop.addEventListener('mouseleave', () => isDesktop() && setOpen(false));
  document.addEventListener('click', (e) => { if (!shop.contains(e.target)) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  if (menuToggle) {
    menuToggle.addEventListener('click', () => {
      const show = nav.classList.toggle('show');
      menuToggle.setAttribute('aria-expanded', show);
    });
  }
})();
</script>
<main>