
<%- include('partials/header', { title }) %>

<section class="detail-wrap">
  <div class="detail-image">
    <img src="<%= product.image_url %>" alt="<%= product.name %>">
  </div>

  <div class="detail-copy">
    <div class="eyebrow">
      <%= product.category_name || product.category || 'TM COSMETIC' %>
    </div>

    <h1><%= product.name %></h1>

    <div class="detail-price">
      ₹<%= Number(product.price).toLocaleString('en-IN') %>

      <% if (product.mrp) { %>
        <del>₹<%= Number(product.mrp).toLocaleString('en-IN') %></del>
      <% } %>
    </div>

    <p>
      <%= product.description || 'Discover this beauty essential from TM Cosmetic.' %>
    </p>

    <!-- ADD TO CART FORM -->
    <form action="/cart/add" method="POST">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <input type="hidden" name="quantity" value="1">

      <button type="submit" class="button">
        Add to bag <span>→</span>
      </button>
    </form>

    <p class="detail-note">
      ✦ Secure checkout · Easy customer support
    </p>

    <a class="text-link" href="/products">
      ← Continue shopping
    </a>
  </div>
</section>

<%- include('partials/footer') %>
