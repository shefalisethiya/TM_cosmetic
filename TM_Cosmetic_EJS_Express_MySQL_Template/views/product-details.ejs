<%- include('partials/header', { title }) %>
<section class="detail-wrap">
  <div class="detail-image"><img src="<%= product.image_url %>" alt="<%= product.name %>"></div>
  <div class="detail-copy"><div class="eyebrow"><%= product.category_name || product.category || 'TM COSMETIC' %></div>
    <h1><%= product.name %></h1><div class="detail-price">₹<%= Number(product.price).toLocaleString('en-IN') %>
      <% if (product.mrp) { %><del>₹<%= Number(product.mrp).toLocaleString('en-IN') %></del><% } %></div>
    <p><%= product.description || 'Discover this beauty essential from TM Cosmetic.' %></p>
    <button class="button" onclick="alert('Connect cart and checkout functionality to your backend.')">Add to bag <span>→</span></button>
    <p class="detail-note">✦ Secure checkout · Easy customer support</p>
    <a class="text-link" href="/products">← Continue shopping</a>
  </div>
</section>
<%- include('partials/footer') %>