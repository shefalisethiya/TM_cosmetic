
<%- include('partials/header', { title }) %>

<%
  const inStock = product.in_stock === true;
%>

<section class="detail-wrap <%= inStock ? '' : 'is-out' %>" data-product-card>

  <div class="detail-image">

    <img
      src="<%= product.image_url || '/images/placeholder.jpg' %>"
      alt="<%= product.name %>"
    >

    <% if (!inStock) { %>
      <div class="out-of-stock-overlay">
        <span>OUT OF STOCK</span>
      </div>
    <% } %>

  </div>

  <div class="detail-copy">

    <div class="eyebrow">
      <%= product.category_name || product.category || 'TM COSMETIC' %>
    </div>

    <h1><%= product.name %></h1>

    <div class="detail-price">
      ₹<%= Number(product.price).toLocaleString('en-IN') %>

      <% if (product.mrp && Number(product.mrp) > Number(product.price)) { %>
        <del>₹<%= Number(product.mrp).toLocaleString('en-IN') %></del>
      <% } %>
    </div>

    <p>
      <%= product.description || 'Discover this beauty essential from TM Cosmetic.' %>
    </p>

    <% if (inStock) { %>

      <p class="stock-status in-stock">In Stock</p>

      <form action="/cart/add" method="POST" class="js-add-to-cart">

        <input type="hidden" name="productId" value="<%= product.id %>">
        <input type="hidden" name="quantity" value="1">

        <button type="submit" class="button">
          Add to bag <span>→</span>
        </button>

      </form>

    <% } else { %>

      <p class="out-note">This item is currently out of stock.</p>

      <button type="button" class="button" disabled>
        Out of Stock
      </button>

    <% } %>

    <p class="card-msg" hidden></p>

    <p class="detail-note">
      ✦ Secure checkout · Easy customer support
    </p>

    <a class="text-link" href="/products">
      ← Continue shopping
    </a>

  </div>

</section>

<%- include('partials/footer') %>
