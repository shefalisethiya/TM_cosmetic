
<%- include('../partials/header', { title }) %>

<style>
  .product-page {
    min-height: 650px;
    padding: 40px 20px;
    background: #fff5f6;
  }

  .product-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 35px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
  }

  .product-heading {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #f0dfe3;
  }

  .product-heading h2 {
    margin: 0 0 8px;
    color: #8e3654;
    font-size: 27px;
  }

  .product-heading p {
    margin: 0;
    color: #777;
    font-size: 14px;
  }

  .product-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    color: #444;
    font-size: 14px;
    font-weight: 600;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e5d5da;
    border-radius: 7px;
    outline: none;
    font-size: 14px;
    background: #fff;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus {
    border-color: #ad5574;
    box-shadow: 0 0 0 3px rgba(173, 85, 116, 0.10);
  }

  .form-group input[type="file"] {
    background: #fff9fa;
  }

  .help-text {
    color: #888;
    font-size: 12px;
  }

  .error-message {
    padding: 13px 16px;
    margin-bottom: 22px;
    color: #a32942;
    background: #fff0f2;
    border: 1px solid #f2c8d0;
    border-radius: 7px;
    font-size: 14px;
  }

  .image-preview {
    display: none;
    margin-top: 10px;
    max-width: 180px;
    max-height: 180px;
    object-fit: contain;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 5px;
  }

  .form-actions {
    grid-column: 1 / -1;
    display: flex;
    gap: 12px;
    margin-top: 12px;
    padding-top: 22px;
    border-top: 1px solid #f0dfe3;
  }

  .btn {
    display: inline-block;
    padding: 12px 25px;
    border: none;
    border-radius: 7px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-submit {
    color: #fff;
    background: #9d4565;
  }

  .btn-submit:hover {
    background: #813651;
  }

  .btn-cancel {
    color: #555;
    background: #f1eeee;
  }

  .btn-cancel:hover {
    background: #e5dfe1;
  }

  @media (max-width: 700px) {
    .product-container {
      padding: 22px 16px;
    }

    .product-form {
      grid-template-columns: 1fr;
    }

    .form-group.full-width,
    .form-actions {
      grid-column: 1;
    }

    .product-heading h2 {
      font-size: 22px;
    }
  }
</style>

<section class="product-page">
  <div class="product-container">

    <div class="product-heading">
      <h2>Add New Product</h2>
      <p>Enter product information to add an item to TM Cosmetic inventory.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message">
        <strong>Error:</strong> <%= error %>
      </div>
    <% } %>

    <form
      action="/manage-products/add"
      method="POST"
      enctype="multipart/form-data"
      class="product-form"
    >

      <!-- PRODUCT NAME -->
      <div class="form-group">
        <label for="product_name">Product Name *</label>
        <input
          type="text"
          id="product_name"
          name="product_name"
          placeholder="Enter product name"
          value="<%= product.product_name || '' %>"
          required
        >
      </div>

      <!-- BRAND NAME -->
      <div class="form-group">
        <label for="brand_name">Brand Name</label>
        <input
          type="text"
          id="brand_name"
          name="brand_name"
          placeholder="Enter brand name"
          value="<%= product.brand_name || '' %>"
        >
      </div>

      <!-- CATEGORY -->
      <div class="form-group">
        <label for="category">Category</label>
        <input
          type="text"
          id="category"
          name="category"
          placeholder="Example: Skincare"
          value="<%= product.category || '' %>"
        >
      </div>

      <!-- SUB CATEGORY -->
      <div class="form-group">
        <label for="sub_category">Sub Category</label>
        <input
          type="text"
          id="sub_category"
          name="sub_category"
          placeholder="Example: Face Cream"
          value="<%= product.sub_category || '' %>"
        >
      </div>

      <!-- SIZE -->
      <div class="form-group">
        <label for="size">Size</label>
        <input
          type="text"
          id="size"
          name="size"
          placeholder="Example: 50ml, 100g"
          value="<%= product.size || '' %>"
        >
      </div>

      <!-- MRP -->
      <div class="form-group">
        <label for="mrp">MRP (₹)</label>
        <input
          type="number"
          id="mrp"
          name="mrp"
          placeholder="Enter MRP"
          min="0"
          step="0.01"
          value="<%= product.mrp ?? '' %>"
        >
      </div>

      <!-- DISCOUNT -->
      <div class="form-group">
        <label for="discount">Discount (%)</label>
        <input
          type="number"
          id="discount"
          name="discount"
          placeholder="Enter discount percentage"
          min="0"
          max="100"
          step="0.01"
          value="<%= product.discount ?? 0 %>"
        >
        <span class="help-text">Enter discount between 0 and 100.</span>
      </div>

      <!-- STOCK -->
      <div class="form-group">
        <label for="stock">Stock Quantity</label>
        <input
          type="number"
          id="stock"
          name="stock"
          placeholder="Enter available stock"
          min="0"
          step="1"
          value="<%= product.stock ?? '' %>"
        >
      </div>

      <!-- MANUFACTURING DATE -->
      <div class="form-group">
        <label for="mfg_date">Manufacturing Date</label>
        <input
          type="date"
          id="mfg_date"
          name="mfg_date"
          value="<%= product.mfg_date ? String(product.mfg_date).slice(0, 10) : '' %>"
        >
      </div>

      <!-- EXPIRY DATE -->
      <div class="form-group">
        <label for="expiry_date">Expiry Date</label>
        <input
          type="date"
          id="expiry_date"
          name="expiry_date"
          value="<%= product.expiry_date ? String(product.expiry_date).slice(0, 10) : '' %>"
        >
      </div>

      <!-- PRODUCT IMAGE -->
      <div class="form-group full-width">
        <label for="product_image">Product Image</label>
        <input
          type="file"
          id="product_image"
          name="product_image"
          accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
        >
        <span class="help-text">
          Supported formats: JPG, JPEG, PNG and WEBP. Maximum size: 5 MB.
        </span>

        <img
          id="imagePreview"
          class="image-preview"
          alt="Product image preview"
        >
      </div>

      <!-- FORM BUTTONS -->
      <div class="form-actions">
        <button type="submit" class="btn btn-submit">
          Save Product
        </button>

        <a href="/manage-products" class="btn btn-cancel">
          Cancel
        </a>
      </div>

    </form>
  </div>
</section>

<script>
  const imageInput = document.getElementById('product_image');
  const imagePreview = document.getElementById('imagePreview');

  imageInput.addEventListener('change', function () {
    const file = this.files[0];

    if (!file) {
      imagePreview.style.display = 'none';
      imagePreview.removeAttribute('src');
      return;
    }

    const allowedTypes = [
      'image/jpeg',
      'image/png',
      'image/webp'
    ];

    if (!allowedTypes.includes(file.type)) {
      alert('Please select a JPG, JPEG, PNG or WEBP image.');
      this.value = '';
      imagePreview.style.display = 'none';
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      alert('Image size must not exceed 5 MB.');
      this.value = '';
      imagePreview.style.display = 'none';
      return;
    }

    const reader = new FileReader();

    reader.onload = function (event) {
      imagePreview.src = event.target.result;
      imagePreview.style.display = 'block';
    };

    reader.readAsDataURL(file);
  });
</script>

<%- include('../partials/footer') %>
