
<%- include('../partials/header', { title }) %>

<style>
  .products-page {
    min-height: 650px;
    padding: 40px 20px;
    background: #fff5f6;
  }

  .products-container {
    max-width: 1350px;
    margin: auto;
    padding: 30px;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 5px 25px rgba(0,0,0,.05);
  }

  .products-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 25px;
  }

  .products-heading h1 {
    color: #743b50;
    margin: 0 0 8px;
  }

  .products-heading p {
    color: #777;
    margin: 0;
  }

  .add-btn, .action-btn {
    display: inline-block;
    padding: 9px 15px;
    border-radius: 6px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 13px;
  }

  .add-btn {
    background: #a64d70;
    color: white;
  }

  .edit-btn {
    background: #fff0d9;
    color: #9a641c;
  }

  .delete-btn {
    background: #ffe4e4;
    color: #b42323;
  }

  .table-wrapper {
    overflow-x: auto;
  }

  .products-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1100px;
  }

  .products-table th {
    background: #f8e7ed;
    color: #743b50;
    padding: 13px;
    text-align: left;
    white-space: nowrap;
  }

  .products-table td {
    padding: 12px;
    border-bottom: 1px solid #eee;
    color: #444;
    vertical-align: middle;
  }

  .product-img {
    width: 55px;
    height: 55px;
    object-fit: cover;
    border-radius: 7px;
    border: 1px solid #eee;
  }

  .no-image {
    color: #999;
    font-size: 12px;
  }

  .alert {
    padding: 12px;
    border-radius: 6px;
    margin-bottom: 18px;
  }

  .success {
    background: #e8f7ed;
    color: #207443;
  }

  .empty-message {
    text-align: center;
    padding: 35px;
    color: #888;
  }

  @media(max-width: 600px) {
    .products-container {
      padding: 18px;
    }
  }
</style>

<section class="products-page">
  <div class="products-container">

    <div class="products-heading">
      <div>
        <h1>Product Management</h1>
        <p>View and manage TM Cosmetic inventory items.</p>
      </div>

      <a href="/manage-products/add" class="add-btn">
        + Add New Product
      </a>
    </div>

    <% if (created) { %>
      <div class="alert success">Product added successfully.</div>
    <% } %>

    <% if (updated) { %>
      <div class="alert success">Product updated successfully.</div>
    <% } %>

    <% if (deleted) { %>
      <div class="alert success">Product deleted successfully.</div>
    <% } %>

    <div class="table-wrapper">
      <table class="products-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Product Name</th>
            <th>Brand Name</th>
            <th>Category</th>
            <th>Sub Category</th>
            <th>Size</th>
            <th>MRP (₹)</th>
            <th>Discount (%)</th>
            <th>Mfg Date</th>
            <th>Expiry Date</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% if (products && products.length > 0) { %>

            <% products.forEach(function(item) { %>
              <tr>
                <td><%= item.id %></td>

                <td>
                  <% if (item.product_image) { %>
                    <img
                      src="<%= item.product_image %>"
                      alt="Product"
                      class="product-img"
                    >
                  <% } else { %>
                    <span class="no-image">No image</span>
                  <% } %>
                </td>

                <td><%= item.product_name %></td>
                <td><%= item.brand_name || '-' %></td>
                <td><%= item.category || '-' %></td>
                <td><%= item.sub_category || '-' %></td>
                <td><%= item.size || '-' %></td>
                <td>₹<%= item.mrp %></td>
                <td><%= item.discount || 0 %>%</td>
                <td><%= item.mfg_date || '-' %></td>
                <td><%= item.expiry_date || '-' %></td>
                <td><%= item.stock %></td>

                <td>
                  <a
                    href="/manage-products/<%= item.id %>/edit"
                    class="action-btn edit-btn"
                  >
                    Edit
                  </a>

                  <form
                    action="/manage-products/<%= item.id %>/delete"
                    method="POST"
                    style="display:inline;"
                    onsubmit="return confirm('Are you sure you want to delete this product?');"
                  >
                    <button type="submit" class="action-btn delete-btn">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>

          <% } else { %>
            <tr>
              <td colspan="13" class="empty-message">
                No products found. Click Add New Product to get started.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
