
<%- include('../partials/header', { title }) %>

<style>
/* =========================================
   TM COSMETIC - SUPER ADMIN DASHBOARD
========================================= */

.super-admin-page {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  min-height: 650px;
  padding: 40px 30px !important;
  margin: 0 !important;
  background: #fff5f6 !important;
  box-sizing: border-box;
}

.super-admin-page *,
.super-admin-page *::before,
.super-admin-page *::after {
  box-sizing: border-box;
}

.super-admin-layout {
  display: flex !important;
  flex-direction: row !important;
  align-items: stretch !important;
  gap: 25px !important;
  width: 100% !important;
  max-width: 1400px;
  margin: 0 auto !important;
}

/* LEFT SIDEBAR */

.super-admin-sidebar {
  display: flex !important;
  flex-direction: column !important;
  flex: 0 0 250px !important;
  width: 250px !important;
  min-width: 250px !important;
  min-height: 600px;
  padding: 30px 20px !important;
  background: #68474a !important;
  color: #ffffff !important;
  border-radius: 8px;
}

.admin-sidebar-heading {
  padding-bottom: 25px;
  border-bottom: 1px solid rgba(255,255,255,0.25);
}

.admin-sidebar-heading .auth-eyebrow {
  color: #ffffff !important;
  font-size: 11px;
  letter-spacing: 2px;
}

.admin-sidebar-heading h2 {
  color: #ffffff !important;
  font-size: 23px;
  margin: 12px 0 0 !important;
}

.admin-sidebar-nav {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  gap: 8px !important;
  margin-top: 25px !important;
  width: 100%;
}

.super-admin-page .admin-sidebar-nav a {
  display: block !important;
  width: 100% !important;
  padding: 14px 15px !important;
  margin: 0 !important;
  color: #ffffff !important;
  background: transparent !important;
  text-decoration: none !important;
  font-size: 14px;
  line-height: 1.5;
  border-radius: 5px;
  transition: background 0.3s ease;
}

.super-admin-page .admin-sidebar-nav a:hover,
.super-admin-page .admin-sidebar-nav a.active {
  background: #8b6265 !important;
  color: #ffffff !important;
}

/* ITEM MANAGEMENT HEADING */

.admin-nav-heading {
  padding: 15px 15px 5px;
  color: #e8cfd1;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.super-admin-page .admin-sidebar-nav a.admin-nav-subitem {
  padding-left: 28px !important;
}

/* LOGOUT */

.admin-sidebar-logout {
  margin-top: auto !important;
  padding-top: 30px;
}

.admin-sidebar-logout form {
  margin: 0 !important;
  width: 100%;
}

.super-admin-page .admin-sidebar-logout button {
  display: block;
  width: 100% !important;
  padding: 13px !important;
  color: #ffffff !important;
  background: #a46d70 !important;
  border: none !important;
  border-radius: 5px;
  cursor: pointer;
}

.super-admin-page .admin-sidebar-logout button:hover {
  background: #bd8588 !important;
}

/* RIGHT DASHBOARD CONTENT */

.super-admin-content {
  display: block !important;
  flex: 1 1 auto !important;
  min-width: 0;
  padding: 35px !important;
  margin: 0 !important;
  background: #ffffff !important;
  border-radius: 8px;
}

.admin-dashboard-header {
  display: block;
  margin-bottom: 35px;
}

.admin-dashboard-header .auth-eyebrow {
  color: #a46d70;
  font-size: 11px;
  letter-spacing: 2px;
}

.admin-dashboard-header h1 {
  color: #382c2d;
  font-size: 32px;
  margin: 15px 0 !important;
}

.admin-dashboard-header h1 em {
  color: #8b6265;
}

.admin-dashboard-header .auth-intro {
  color: #777777;
  font-size: 15px;
  margin: 0 !important;
}

/* STATISTICS CARDS */

.super-admin-page .admin-stats {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 20px !important;
  width: 100%;
  margin: 0 !important;
}

.admin-stat-link {
  display: block;
  min-width: 0;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.super-admin-page .admin-stat-card {
  display: block !important;
  height: 100%;
  min-width: 0;
  padding: 25px !important;
  margin: 0 !important;
  background: #fff5f6 !important;
  border: 1px solid #eadadd !important;
  border-radius: 8px;
  box-shadow: 0 3px 12px rgba(80,40,45,0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.super-admin-page .admin-stat-link:hover .admin-stat-card {
  transform: translateY(-3px);
  box-shadow: 0 5px 16px rgba(80,40,45,0.12);
}

.super-admin-page .admin-stat-card h3 {
  color: #68474a !important;
  font-size: 15px;
  font-weight: 600;
  margin: 0 0 15px !important;
}

.super-admin-page .admin-stat-card p {
  color: #68474a !important;
  font-size: 32px;
  font-weight: 700;
  line-height: 1.2;
  margin: 0 !important;
}

.admin-stat-card span {
  display: block;
  margin-top: 12px;
  color: #a46d70;
  font-size: 13px;
}

/* TABLET */

@media (max-width: 900px) {
  .super-admin-page .admin-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .super-admin-content {
    padding: 25px !important;
  }
}

/* MOBILE */

@media (max-width: 650px) {
  .super-admin-page {
    padding: 20px 12px !important;
  }

  .super-admin-layout {
    flex-direction: column !important;
  }

  .super-admin-sidebar {
    flex: 0 0 auto !important;
    width: 100% !important;
    min-width: 0 !important;
    min-height: auto;
  }

  .admin-sidebar-logout {
    margin-top: 20px !important;
  }

  .super-admin-content {
    width: 100%;
    padding: 22px !important;
  }

  .super-admin-page .admin-stats {
    grid-template-columns: 1fr !important;
  }

  .admin-dashboard-header h1 {
    font-size: 26px;
  }
}
</style>

<!-- SUPER ADMIN DASHBOARD -->

<section class="super-admin-page">

  <div class="super-admin-layout">

    <!-- LEFT VERTICAL SIDEBAR -->

    <aside class="super-admin-sidebar">

      <div class="admin-sidebar-heading">
        <span class="auth-eyebrow">TM COSMETIC</span>
        <h2>Super Admin</h2>
      </div>

      <nav class="admin-sidebar-nav">

        <a href="/super-admin/dashboard" class="active">
          Dashboard
        </a>

        <a href="/super-admin/staff">
          Manage Staff
        </a>

        <a href="/super-admin/staff/create">
          Create Admin / Delivery
        </a>

        <a href="/super-admin/users/all">
          Manage Users
        </a>

        <!-- ITEM MANAGEMENT -->

        <div class="admin-nav-heading">
          Item Management
        </div>

        <a href="/manage-products/add" class="admin-nav-subitem">
          + Add Item
        </a>

        <a href="/manage-products" class="admin-nav-subitem">
          View / Read Items
        </a>

        <a href="/">
          Visit Store
        </a>

      </nav>

      <!-- LOGOUT -->

      <div class="admin-sidebar-logout">
        <form action="/logout" method="POST">
          <button type="submit">
            Logout
          </button>
        </form>
      </div>

    </aside>

    <!-- RIGHT MAIN CONTENT -->

    <main class="super-admin-content">

      <div class="admin-dashboard-header">

        <span class="auth-eyebrow">
          TM COSMETIC MANAGEMENT
        </span>

        <h1>
          Super Admin <em>Dashboard</em>
        </h1>

        <p class="auth-intro">
          Welcome, <%= user.name %>. Manage your staff and registered users.
        </p>

      </div>

      <!-- DASHBOARD STATISTICS -->

      <div class="admin-stats">

        <a href="/super-admin/users/all" class="admin-stat-link">
          <div class="admin-stat-card">
            <h3>Total Users</h3>
            <p><%= stats.total_users || 0 %></p>
            <span>View all users →</span>
          </div>
        </a>

        <a href="/super-admin/users/super-admin" class="admin-stat-link">
          <div class="admin-stat-card">
            <h3>Super Admins</h3>
            <p><%= stats.super_admins || 0 %></p>
            <span>View Super Admins →</span>
          </div>
        </a>

        <a href="/super-admin/users/admin" class="admin-stat-link">
          <div class="admin-stat-card">
            <h3>Admins</h3>
            <p><%= stats.admins || 0 %></p>
            <span>View Admins →</span>
          </div>
        </a>

        <a href="/super-admin/users/delivery" class="admin-stat-link">
          <div class="admin-stat-card">
            <h3>Delivery Persons</h3>
            <p><%= stats.delivery_users || 0 %></p>
            <span>View Delivery Persons →</span>
          </div>
        </a>

        <a href="/super-admin/users/b2b" class="admin-stat-link">
          <div class="admin-stat-card">
            <h3>B2B Users</h3>
            <p><%= stats.b2b_users || 0 %></p>
            <span>View B2B Users →</span>
          </div>
        </a>

        <a href="/super-admin/users/b2c" class="admin-stat-link">
          <div class="admin-stat-card">
            <h3>B2C Users</h3>
            <p><%= stats.b2c_users || 0 %></p>
            <span>View B2C Users →</span>
          </div>
        </a>

      </div>

    </main>

  </div>

</section>

<%- include('../partials/footer') %>
