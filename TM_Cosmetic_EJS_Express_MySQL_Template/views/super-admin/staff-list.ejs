
<%- include('../partials/header', { title }) %>

<section class="auth-page">
  <div class="auth-card auth-card-wide">

    <span class="auth-eyebrow">SUPER ADMIN PANEL</span>

    <h1>Staff <em>Management</em></h1>

    <p class="auth-intro">
      View and manage Admin and Delivery Person accounts.
    </p>

    <% if (created) { %>
      <div class="auth-success">
        Staff account created successfully.
      </div>
    <% } %>

    <div style="margin: 20px 0;">
      <a href="/super-admin/staff/create" class="button">
        + Create New Staff
      </a>

      <a href="/super-admin/dashboard" class="button">
        Back to Dashboard
      </a>
    </div>

    <div style="overflow-x:auto; margin-top:20px;">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Account Type</th>
            <th>Created At</th>
          </tr>
        </thead>

        <tbody>
          <% if (staff.length === 0) { %>
            <tr>
              <td colspan="6">No staff accounts found.</td>
            </tr>
          <% } %>

          <% staff.forEach(person => { %>
            <tr>
              <td><%= person.id %></td>
              <td><%= person.name %></td>
              <td><%= person.email %></td>
              <td><%= person.phone || '-' %></td>
              <td>
                <% if (Number(person.role_id) === 5) { %>
                  Admin
                <% } else if (Number(person.role_id) === 4) { %>
                  Delivery Person
                <% } %>
              </td>
              <td>
                <%= person.created_at
                  ? new Date(person.created_at).toLocaleDateString('en-IN')
                  : '-' %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
